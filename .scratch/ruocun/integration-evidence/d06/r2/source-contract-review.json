            "1: // 剪贴板图片读取(macOS 用 osascript)。Linux/Windows 预留但不实现。",
            "2: import { execFileSync } from \"node:child_process\";",
            "3: import { readFile, rm } from \"node:fs/promises\";",
            "4: ",
            "5: /** 从剪贴板读取 PNG 图片，返回 base64 + mediaType。无图片或失败返回 null。 */",
            "6: export async function getImageFromClipboard(): Promise<{ base64: string; mediaType: string } | null> {",
            "7:   if (process.platform !== \"darwin\") return null;",
            "8:   const tmpPath = `/tmp/dao_paste_${Date.now()}.png`;",
            "9:   try {",
            "10:     // 先检查剪贴板是否有 PNG 图片",
            "11:     const check = execFileSync(\"osascript\", [\"-e\", \"the clipboard as «class PNGf»\"], { timeout: 5000, encoding: \"utf8\", stdio: [\"pipe\", \"pipe\", \"pipe\"] }).trim();",
            "12:     if (!check || check === \"missing value\") return null;",
            "13:     // 写到临时文件",
            "14:     execFileSync(\"osascript\", [",
            "15:       \"-e\", \"set png_data to (the clipboard as «class PNGf»)\",",
            "16:       \"-e\", `set fp to open for access POSIX file \"${tmpPath}\" with write permission`,",
            "17:       \"-e\", \"write png_data to fp\",",
            "18:       \"-e\", \"close access fp\",",
            "19:     ], { timeout: 5000, stdio: [\"pipe\", \"pipe\", \"pipe\"] });",
            "20:     const buf = await readFile(tmpPath);",
            "21:     if (buf.length === 0) return null;",
            "22:     if (buf.length > 5 * 1024 * 1024) return null; // 5MB 护栏",
            "23:     return { base64: buf.toString(\"base64\"), mediaType: \"image/png\" };",
            "24:   } catch {",
            "25:     return null;",
            "26:   } finally {",
            "27:     await rm(tmpPath, { force: true }).catch(() => {});",
            "28:   }",
            "29: }"
          ]
        }
      ]
