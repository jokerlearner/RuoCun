            "19:   const diagnostic = (value: unknown) => {",
            "20:     if (diagnosticPath) { try { writeFileSync(diagnosticPath, JSON.stringify(value, null, 2)); } catch {} }",
            "21:   };",
            "22:   const attention = createTabAttention(formatTabTitle(deps.welcome.info.cwd, deps.getTabName?.()));",
            "23:   let motion: WelcomeMotion | undefined;",
            "24:   let focused = true;",
            "25:   const graphics = deps.welcome.bg === \"dark\" && deps.welcome.caps.tier === \"truecolor\"",
            "26:     && process.stdin.isTTY && process.stdout.isTTY && !deps.skipBanner",
            "27:     && process.env.INK_SCREEN_READER !== \"true\";",
            "28:   diagnostic({ stage: \"graphics-check\", graphics, dark: deps.welcome.bg === \"dark\",",
            "29:     tier: deps.welcome.caps.tier, skipBanner: !!deps.skipBanner });",
            "30:   const reports = graphics ? createTerminalReports(process.stdin, process.stdout, {",
            "31:     onUserInput: () => motion?.pause(),",
            "32:     onFocus: value => { focused = value; motion?.setFocused(value); },",
            "33:   }) : undefined;",
            "34:   let app: ReturnType<typeof render> | undefined;",
            "35:   const cleanup = () => { motion?.dispose(); attention.dispose(); reports?.dispose(); };",
            "36:   process.once(\"exit\", cleanup); // 外部 SIGTERM/异常退出也恢复终端模式。",
            "37:   try {",
            "38:     if (reports) {",
            "39:       const cell = await reports.probe();",
            "40:       diagnostic({ stage: \"probe\", cell: cell ?? null });",
            "41:       motion = createWelcomeMotion({ reports, stdout: process.stdout, cell,",
            "42:         waitUntilRenderFlush: async () => { await app?.waitUntilRenderFlush(); },",
            "43:         observe: snapshot => diagnostic({ stage: \"motion\", ...snapshot }),",
            "44:       });",
            "45:       motion.setFocused(focused);",
            "46:     }",
            "47:     app = render(<App {...deps} ownedViewport={deps.ownedViewport ?? (process.env.DAO_OWNED_TERMINAL === \"1\")}",
            "48:       welcomeMotion={motion ?? deps.welcomeMotion} tabAttention={attention} />,",
            "49:       { interactive: true, exitOnCtrlC: false, ...(reports ? { stdin: reports.input } : {}) } as unknown as Parameters<typeof render>[1]);",
            "50:     await app.waitUntilExit();",
            "51:   } finally {",
            "52:     process.removeListener(\"exit\", cleanup);",
            "53:     cleanup();",
