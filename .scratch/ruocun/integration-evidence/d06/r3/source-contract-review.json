            "45:       if (disposed || marked === kind) return;",
            "46:       marked = kind;",
            "47:       renderTitle();",
            "48:     },",
            "49:     clear() {",
            "50:       if (disposed || !marked) return;",
            "51:       marked = undefined;",
            "52:       renderTitle();",
            "53:     },",
            "54:     setTitle(title) {",
            "55:       const next = cleanTitle(title) || DISPLAY_NAME;",
            "56:       if (disposed || next === base) return;",
            "57:       base = next;",
            "58:       renderTitle();",
            "59:     },",
            "60:     dispose() {",
            "61:       if (disposed) return;",
            "62:       if (marked) setTitle(base);",
            "63:       write(\"\\x1b[?1004l\\x1b[23;0t\");",
            "64:       disposed = true;",
            "65:     },",
            "66:   };"
          ]
        }
      ]
    }
  ]
}
