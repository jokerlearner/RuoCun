            "1: // 最小 East-Asian-Width:CJK / Hangul / 假名 / 全角 / 常见 emoji 计 2 列,其余 1 列。",
            "2: function isWide(cp: number): boolean {",
            "3:   return (",
            "4:     (cp >= 0x1100 && cp <= 0x115f) ||",
            "5:     (cp >= 0x2e80 && cp <= 0xa4cf) ||",
            "6:     (cp >= 0xac00 && cp <= 0xd7a3) ||",
            "7:     (cp >= 0xf900 && cp <= 0xfaff) ||",
            "8:     (cp >= 0xfe30 && cp <= 0xfe4f) ||",
            "9:     (cp >= 0xff00 && cp <= 0xff60) ||",
            "10:     (cp >= 0xffe0 && cp <= 0xffe6) ||",
            "11:     (cp >= 0x1f300 && cp <= 0x1faff) ||",
            "12:     (cp >= 0x20000 && cp <= 0x3fffd)",
            "13:   );",
            "14: }",
            "15: ",
            "16: export function displayWidth(s: string): number {",
            "17:   let w = 0;",
            "18:   for (const ch of s) {",
            "19:     w += isWide(ch.codePointAt(0)!) ? 2 : 1;",
            "20:   }",
            "21:   return w;",
            "22: }",
            "23: ",
            "24: export function padEnd(s: string, width: number): string {",
            "25:   const w = displayWidth(s);",
            "26:   return w >= width ? s : s + \" \".repeat(width - w);",
            "27: }"
          ]
        }
      ]
    },
